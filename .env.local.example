# Copy this file to .env.local for local development.
# Do not commit real API keys.

# Required when M2+ LLM-backed stages are run.
LLM_API_KEY=

# Optional OpenAI-compatible provider defaults.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Optional GitHub token for collector development.
GITHUB_TOKEN=
