{
  "name": "@delta-cv/cli",
  "version": "0.1.0",
  "description": "Track real engineering capabilities through GitHub activity and auto-update your resume.",
  "license": "AGPL-3.0-or-later",
  "author": "delta-cv contributors",
  "homepage": "https://github.com/delta-cv/delta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delta-cv/delta.git"
  },
  "bugs": {
    "url": "https://github.com/delta-cv/delta/issues"
  },
  "keywords": ["resume", "cv", "github-action", "developer-tools", "automation"],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "delta": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.js.map",
    "template",
    "assets",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "pnpm build:action && pnpm build:cli",
    "build:action": "DELTA_BUILD_TARGET=action tsup",
    "build:cli": "DELTA_BUILD_TARGET=cli tsup",
    "dev:cli": "tsx src/cli.ts",
    "dev:action": "tsx src/action.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/cli.ts eval",
    "verify:dist": "node scripts/check-dist-present.mjs",
    "verify:bundle-size": "node scripts/check-bundle-size.mjs",
    "verify:template-version": "node scripts/check-template-version.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm verify:bundle-size && pnpm verify:template-version",
    "preview": "node -e \"const h=require('http'),f=require('fs'),p=require('path');h.createServer((q,r)=>{let u=q.url==='/'?'/preview/index.html':q.url;const fp=p.join(process.cwd(),u);const ext={'.html':'text/html','.js':'text/javascript','.css':'text/css','.json':'application/json'}[p.extname(fp)]||'application/octet-stream';f.readFile(fp,(e,d)=>{if(e){r.writeHead(404);r.end('Not found');}else{r.writeHead(200,{'Content-Type':ext+';charset=utf-8'});r.end(d);}})}).listen(8080,()=>console.log('Preview server: http://localhost:8080/preview/index.html'))\""
  },
  "dependencies": {
    "@octokit/graphql": "^8.1.1",
    "@octokit/rest": "^21.0.2",
    "citty": "^0.1.6",
    "eta": "^3.5.0",
    "fast-fuzzy": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.17.6",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}
